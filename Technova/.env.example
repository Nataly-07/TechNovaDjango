# Entorno: dev | staging | prod
TECHNOVA_ENV=dev

# Django
DJANGO_SECRET_KEY=replace-with-a-long-secret-at-least-32-chars
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Railway / producción (ejemplo):
# DJANGO_ALLOWED_HOSTS=.railway.app,tu-app.up.railway.app
# DJANGO_CSRF_TRUSTED_ORIGINS=https://tu-app.up.railway.app
# TECHNOVA_PUBLIC_BASE_URL=https://tu-app.up.railway.app

# Railway inyecta DATABASE_URL al vincular PostgreSQL (no hace falta definir DB_*).
# DATABASE_URL=postgresql://user:pass@host:5432/railway

# Base de datos
DB_ENGINE=django.db.backends.postgresql
DB_NAME=DB_TN
DB_USER=postgres
DB_PASSWORD=Admin
DB_HOST=localhost
DB_PORT=5432

# --- Correo local (dev): SMTP Gmail ---
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# --- Correo producción (Railway): Resend — https://resend.com ---
# RESEND_API_KEY=re_xxxxxxxx
# DEFAULT_FROM_EMAIL=Technova <onboarding@resend.dev>
# RESEND_FROM_EMAIL=Technova <onboarding@resend.dev>
# --- PayPal Sandbox (checkout cliente y POS empleado) ---
# TECHNOVA_PAYPAL_CLIENT_ID=
# TECHNOVA_PAYPAL_CLIENT_SECRET=
# TECHNOVA_PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Moneda en PayPal: USD (convierte desde COP) o COP directo.
# TECHNOVA_PAYPAL_CURRENCY=USD
# COP por 1 USD si TECHNOVA_PAYPAL_CURRENCY=USD (ej. 2.322.041 COP → ~580.51 USD con 4000).
# TECHNOVA_PAYPAL_COP_PER_USD=4000

TECHNOVA_PUBLIC_BASE_URL=http://127.0.0.1:8000
# Logo en correos HTML (URL absoluta). Si omites esta línea, se usa TECHNOVA_PUBLIC_BASE_URL + /static/.../logo-technova-email.png
# Para forzar una URL externa (p. ej. CDN): TECHNOVA_EMAIL_LOGO_URL=https://ejemplo.com/logo.png
# 0 = usar solo URL del logo en el HTML (recomendado). 1 = incrustación Base64 si está implementada en el proyecto.
TECHNOVA_EMAIL_LOGO_EMBED_BASE64=0
# 0 = envío sincrónico tras registro (recomendado para ver errores SMTP). 1 = hilo en segundo plano.
TECHNOVA_EMAIL_REGISTRO_ASYNC=0
